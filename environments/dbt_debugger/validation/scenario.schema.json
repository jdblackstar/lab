{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/dbt_debugger/scenario.schema.json",
  "title": "DBT Debugger scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "title",
    "difficulty_tier",
    "failure_categories",
    "has_bug",
    "metadata",
    "symptom",
    "dag",
    "dbt_project",
    "sample_data",
    "run_history",
    "ground_truth",
    "rubric_hints",
    "hypothesis_space",
    "artifact_manifest"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "scenario_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "title": { "type": "string", "minLength": 1 },
    "difficulty_tier": { "type": "integer", "minimum": 1, "maximum": 4 },
    "failure_categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "join",
          "incremental",
          "source_schema",
          "logic",
          "macro",
          "config",
          "no_bug"
        ]
      }
    },
    "has_bug": { "type": "boolean" },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "symptom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "from_role", "message"],
      "properties": {
        "channel": { "type": "string" },
        "from_role": { "type": "string" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "dag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notation", "models"],
      "properties": {
        "notation": { "type": "string", "minLength": 1 },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path", "role"],
            "properties": {
              "name": { "type": "string" },
              "path": { "type": "string" },
              "role": {
                "type": "string",
                "enum": ["staging", "intermediate", "mart", "seed", "other"]
              }
            }
          }
        }
      }
    },
    "dbt_project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content"],
            "properties": {
              "path": { "type": "string" },
              "content": { "type": "string" }
            }
          }
        }
      }
    },
    "sample_data": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["columns", "rows"],
        "properties": {
          "description": { "type": "string" },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "run_history": {
      "type": "object",
      "additionalProperties": true,
      "required": ["summary", "model_results", "tests"],
      "properties": {
        "summary": { "type": "string" },
        "model_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["model", "status"],
            "properties": {
              "model": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_cause",
        "affected_models",
        "fix",
        "common_misdiagnoses",
        "investigation_path"
      ],
      "properties": {
        "root_cause": { "type": "string" },
        "affected_models": { "type": "array", "items": { "type": "string" } },
        "fix": { "type": "string" },
        "common_misdiagnoses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "investigation_path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "rubric_hints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_criteria", "required_evidence"],
      "properties": {
        "pass_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "detail"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["model", "source", "test", "log", "macro", "config"]
              },
              "detail": { "type": "string" }
            }
          }
        },
        "forbidden_claims": { "type": "array", "items": { "type": "string" } }
      }
    },
    "hypothesis_space": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hypothesis", "plausible"],
        "properties": {
          "id": { "type": "string" },
          "hypothesis": { "type": "string" },
          "plausible": { "type": "boolean" }
        }
      }
    },
    "red_herrings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "why_wrong"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "why_wrong": { "type": "string" }
        }
      }
    },
    "artifact_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_visible_globs", "evaluator_only_paths", "immutable_paths"],
      "properties": {
        "tool_visible_globs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evaluator_only_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "immutable_paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
